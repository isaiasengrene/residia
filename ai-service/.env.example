# ──────────────────────────────────────────────
# API Keys — añadir solo los proveedores que uses
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# ──────────────────────────────────────────────
# Configuración de proveedores por agente
# Proveedor: anthropic | openai | google
# ──────────────────────────────────────────────
AGENTE_REGISTRO_PROVEEDOR=anthropic
AGENTE_REGISTRO_MODELO=claude-sonnet-4-6

AGENTE_COMUNICACION_PROVEEDOR=anthropic
AGENTE_COMUNICACION_MODELO=claude-sonnet-4-6

AGENTE_SEGUIMIENTO_PROVEEDOR=anthropic
AGENTE_SEGUIMIENTO_MODELO=claude-sonnet-4-6

AGENTE_PAI_PROVEEDOR=anthropic
AGENTE_PAI_MODELO=claude-opus-4-8

# ──────────────────────────────────────────────
# Infraestructura
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://residia:residia_dev@localhost:5432/residia
REDIS_URL=redis://localhost:6379
PORT=3002
